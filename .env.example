# ═══════════════════════════════════════════════════════════════
# Ghost Net Hunter — Environment Configuration
# Copy this file to .env and fill in real values.
# ═══════════════════════════════════════════════════════════════

# ── Database (PostGIS) ───────────────────────────────────────
POSTGRES_USER=ghostnet
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=ghostnet_hunter
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=replace-with-a-strong-random-secret

# ── File Storage ─────────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
CROP_DIR=/app/data/crops
MAX_UPLOAD_SIZE_MB=500

# ── ML / Detection ──────────────────────────────────────────
MODEL_INPUT_SIZE=640
CONFIDENCE_THRESHOLD=0.25
YOLO_WEIGHTS_PATH=/app/models/yolov8-seg-sonar.pt
ONNX_MODEL_PATH=/app/models/yolov8-seg-sonar.onnx
USE_TENSORRT=false

# ── Scoring Fusion Weights ───────────────────────────────────
# See backend/app/services/scoring/README for tuning guidance
SCORE_W1_MODEL=0.50
SCORE_W2_SHADOW=0.30
SCORE_W3_CFAR=0.20
PENALTY_EDGE_SWATH=0.10
PENALTY_TEMPORAL=0.05

# ── Speckle Filter ──────────────────────────────────────────
# Options: lee | frost
SPECKLE_FILTER=lee
LEE_WINDOW_SIZE=7
FROST_DAMPING=2.0

# ── CFAR Detector ────────────────────────────────────────────
CFAR_GUARD_CELLS=4
CFAR_TRAINING_CELLS=16
CFAR_FALSE_ALARM_RATE=0.001

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_TILE_SERVER_URL=

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
